<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Madia.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="White">

    <Grid>
        <Grid x:Name="scannerHost" />

        <StackLayout
            Orientation="Vertical"
            VerticalOptions="End"
            BackgroundColor="#CC000000"
            Padding="12">
            <Label Text="{Binding ResultText}" TextColor="White" />
            <Image Source="{Binding ProductImageUrl}" HeightRequest="120" Aspect="AspectFit" />
            <Label Text="{Binding ProductName}" TextColor="White" FontAttributes="Bold" />
            <Label Text="{Binding ProductBrand}" TextColor="White" />
            <Button Text="Restart scanner" Command="{Binding RestartCommand}" />
        </StackLayout>
    </Grid>
</ContentPage>
