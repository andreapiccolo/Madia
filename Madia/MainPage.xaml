<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Madia.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui;assembly=ZXing.Net.Maui"
    BackgroundColor="White">

    <Grid>
        <zxing:CameraBarcodeReaderView
            x:Name="cameraView"
            IsDetecting="True"
            IsScanning="True"
            BarcodeDetected="CameraView_BarcodeDetected" />

        <StackLayout
            Orientation="Vertical"
            VerticalOptions="End"
            BackgroundColor="#CC000000"
            Padding="12">
            <Label x:Name="lblResult" Text="Point camera at a barcode" TextColor="White" />
            <Image x:Name="productImage" HeightRequest="120" Aspect="AspectFit" />
            <Label x:Name="lblName" TextColor="White" FontAttributes="Bold" />
            <Label x:Name="lblBrand" TextColor="White" />
            <Button Text="Restart scanner" Clicked="OnRestartClicked" />
        </StackLayout>
    </Grid>
</ContentPage>
